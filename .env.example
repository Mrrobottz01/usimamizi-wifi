# Usimamizi Wi-Fi Environment Configuration Example
# Copy this file to .env and adjust variables for local development.

# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-safe-development-key-change-in-production-1234567890
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL default or SQLite for local dev without postgres)
USE_SQLITE=True
DATABASE_URL=postgres://usimamizi:usimamizi_secret_pass@localhost:5432/usimamizi_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Platform Settings
DEFAULT_CURRENCY=TZS
DEFAULT_TIMEZONE=Africa/Dar_es_Salaam
